rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isTutor() {
      return isAuthenticated() && getUserData().role == 'tutor';
    }
    
    function isParent() {
      return isAuthenticated() && getUserData().role == 'parent';
    }
    
    function isParentOf(studentId) {
      return isParent() && getUserData().studentId == studentId;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isTutor());
    }

    // Students Collection
    match /students/{studentId} {
      // Tutors can only read, update, delete their own students
      allow read, update, delete: if isTutor() && resource.data.tutorId == request.auth.uid;
      // When creating, the tutorId must be the tutor's uid
      allow create: if isTutor() && request.resource.data.tutorId == request.auth.uid;
      
      // Parents can ONLY read their own child's record
      allow read: if isParentOf(studentId);
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      // Tutor can read, create, and update attendance if they own the student
      allow read, delete: if isTutor() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.tutorId == request.auth.uid;
      allow create, update: if isTutor() && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.tutorId == request.auth.uid;
      
      // Parents can ONLY read attendance belonging to their child
      allow read: if isParentOf(resource.data.studentId);
    }

    // Access Requests (Anyone can submit access request, authenticated users/tutors can manage)
    match /access_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() && isTutor();
    }
  }
}
